# Production deploy settings, read by `pnpm deploy:prod`.
# Copy to .env.production (gitignored) and fill in.
# Secrets do NOT go here: they live in SST (`sst secret set ... --stage production`).

# AWS_PROFILE=gmj  (default)

# Custom domain. Leaving it empty would detach the domain from CloudFront.
PORTFOLIO_DOMAIN=gmj.engineer
PORTFOLIO_DOMAIN_REDIRECTS=www.gmj.engineer
# PORTFOLIO_CERT_ARN=

# AWS Budgets alerts
PORTFOLIO_BUDGET_EMAIL=
# PORTFOLIO_BUDGET_LIMIT_USD=

# AI backend
PORTFOLIO_AI_ENABLED=true
# PORTFOLIO_AI_DAILY_LIMIT_USD=0.5
# Turnstile site key (public by design, it ships in the HTML)
PUBLIC_TURNSTILE_SITE_KEY=

# Analytics (optional)
# PUBLIC_POSTHOG_KEY=
