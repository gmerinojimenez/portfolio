---
// Self-hosted fonts (Fontsource): only the Latin subset and the weights in
// use. Astro bundles the CSS and copies the font files into the build, so the
// page makes no requests to Google Fonts.
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/inter/latin-600.css';
import '../styles/tokens.css';
import '../styles/global.css';
import type { Locale } from '../lib/locales';

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
---

<!doctype html>
<html lang={locale} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#00212b" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <script is:inline>
      // Runs before first paint: CSS can tell whether JS is available.
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    <script>
      import '../lib/analytics/client';
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
