---
/**
 * Privacy note: a plain static page with the same layout and tokens as the
 * console. Text lives in `content.ts`; the `/es/privacidad` and
 * `/en/privacy` pages only choose the language.
 */
import type { Locale } from '../../lib/locales';
import { localeHome } from '../../i18n/paths';
import Base from '../../layouts/Base.astro';
import { privacyContent } from './content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = privacyContent[locale];
---

<Base locale={locale} title={content.title} description={content.description}>
  <main class="privacy">
    <a class="privacy-back" href={localeHome(locale)}>
      {content.back}
    </a>
    <h1>{content.title}</h1>
    <p class="privacy-updated">{content.updated}</p>
    {content.sections.map((section) => (
      <section>
        <h2>{section.heading}</h2>
        {section.paragraphs.map((text) => (
          <p>{text}</p>
        ))}
        {section.items && (
          <ul>
            {section.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
      </section>
    ))}
  </main>
</Base>

<style>
  .privacy {
    max-width: 68ch;
    margin: 0 auto;
    padding: 32px 16px 64px;
    font-family: var(--font-sans);
    line-height: 1.7;
  }
  h1,
  h2 {
    color: var(--color-title);
    line-height: 1.3;
  }
  h1 {
    margin: 24px 0 4px;
    font-size: 2rem;
  }
  h2 {
    margin: 32px 0 8px;
    font-size: 1.15rem;
  }
  p,
  ul {
    margin: 0 0 12px;
  }
  .privacy-updated {
    color: var(--color-dim);
    font-size: 0.9rem;
  }
  .privacy-back {
    color: var(--color-link);
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
</style>
