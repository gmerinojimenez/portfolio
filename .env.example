# Public PostHog project key (EU Cloud). It ships in the browser bundle by
# design, so it is not a secret. Without it, analytics is off.
PUBLIC_POSTHOG_KEY=

# Testing only: point a local build at a fake server instead of PostHog EU
# (default: https://eu.i.posthog.com). Leave unset in production.
# PUBLIC_POSTHOG_HOST=http://localhost:9999
