# Copy to .env.local (gitignored) and fill in. The content and eval scripts
# load .env.local automatically; Astro reads it too, but only exposes PUBLIC_*
# variables to the browser.

# Anthropic API key for local scripts (pnpm eval, pnpm content:translate).
# Use a separate key from the one stored as the AnthropicApiKey SST secret.
ANTHROPIC_API_KEY=

# Voyage AI key for pnpm content:embed.
VOYAGE_API_KEY=

# Public PostHog project key (EU Cloud). It ships in the browser bundle by
# design, so it is not a secret. Without it, analytics is off.
PUBLIC_POSTHOG_KEY=

# Testing only: point a local build at a fake server instead of PostHog EU
# (default: https://eu.i.posthog.com). Leave unset in production.
# PUBLIC_POSTHOG_HOST=http://localhost:9999

# AI in the console (S10). Both are public values, inlined into the bundle at
# build time. Without either one the console says the AI isn't available yet.
# Function URL of the AI backend (the `aiUrl` output of `sst deploy`).
PUBLIC_AI_URL=
# Cloudflare Turnstile site key (public). For local tests use Cloudflare's
# dummy key 1x00000000000000000000BB (invisible, always passes).
PUBLIC_TURNSTILE_SITE_KEY=
